{
  "Database": {
    "ConnectionString": "",
    "DbType": "MySql",
    "AutoCreateTable": true,
    "AutoSyncStructure": true
  },
  "Jwt": {
    "Issuer": "SuperAdmin",
    "Audience": "SuperAdmin",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 7,
    "Secret": ""
  },
  "MultiTenancy": {
    "Enabled": false
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 100,
    "MaxAttempts": 5,
    // 多副本认领租约（秒）：副本崩溃后到期可被其他副本重新认领
    "LeaseSeconds": 60,
    // 失败退避：第 n 次失败等待 BaseRetryDelaySeconds * 2^(n-1)，上限 MaxRetryDelaySeconds（秒）
    "BaseRetryDelaySeconds": 10,
    "MaxRetryDelaySeconds": 600,
    "RetentionDays": 7
  },
  "Scheduling": {
    // Quartz 工作线程数（并发任务上限）
    "ThreadCount": 10,
    // 启动任务同步锁：等待时间与租约（秒）；滚动发布时仅持锁实例执行差异同步
    "SyncLockWaitSeconds": 10,
    "SyncLockLeaseSeconds": 120,
    // misfire 策略：FireAndProceed（立即补触发）/ RescheduleNextWithRemainingCount（跳过错过触发，按计划重算下一次）
    "MisfireInstruction": "FireAndProceed"
  },
  "Cors": {
    "Enabled": false,
    "AllowedOrigins": [ "http://localhost:5173" ],
    "AllowedHeaders": "Authorization,Content-Type,X-Tenant-Id",
    "AllowedMethods": "GET,POST,PUT,DELETE,OPTIONS",
    "PreflightMaxAgeSeconds": 600
  },
  "RateLimit": {
    "Enabled": true,
    "GlobalPermitLimit": 0,
    "GlobalWindowSeconds": 10,
    "AuthPermitLimit": 100,
    "AuthWindowSeconds": 60
  },
  "Https": {
    "RedirectEnabled": false,
    "HttpsPort": 443,
    "HstsEnabled": false,
    "HstsMaxAgeDays": 180
  },
  "Forwarded": {
    "Enabled": false,
    "Headers": "All",
    "KnownProxies": ""
  },
  "Cache": {
    "RedisEnabled": false,
    "RedisConfiguration": "localhost:6379",
    "InstanceName": "super-admin:",
    "MaximumPayloadBytes": 1048576,
    "Hot": { "LocalSeconds": 30, "DistributedSeconds": 300 },
    "Medium": { "LocalSeconds": 60, "DistributedSeconds": 600 },
    "Cold": { "LocalSeconds": 300, "DistributedSeconds": 1800 }
  },
  "FileStorage": {
    "Provider": "local",
    "RootPath": "uploads",
    "MaxSizeMB": 10,
    "AllowedExtensions": [
      "jpg", "jpeg", "png", "gif", "webp", "bmp",
      "pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "txt", "csv", "md",
      "zip", "rar", "7z"
    ]
  },
  "Mail": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "From": "",
    "Username": "",
    "Password": "",
    "UseSsl": true,
    "Recipients": [],
    "TimeoutMilliseconds": 10000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext:l} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 52428800,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {MachineName} {ThreadId} {SourceContext:l} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*"
}
