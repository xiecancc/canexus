{
  "Database": {
    "ConnectionString": "",
    "DbType": "MySql",
    // 库级判定：用剥离库名的管理连接查 information_schema.SCHEMATA；库不存在且允许时自动建库，否则明确拒绝启动
    "AutoCreateDatabase": true,
    // 结构层：已就绪（版本一致 + 模型表齐全）的启动不执行任何 DDL；以下两项仅影响首次初始化
    "AutoCreateTable": true,
    "AutoSyncStructure": true,
    // Production 部署基线要求 AutoCreateTable / AutoSyncStructure 显式为 false；全新生产库须显式授权一次性初始化
    "AllowSchemaInitialization": false,
    // T5 #13：开启后启动期用 EntityMaintenance 模型快照比对 information_schema 列/主键（默认关闭，
    // 存量库完成一次结构对齐后再开启；任何绕过迁移通道改表都会导致启动失败）
    "ValidateModelStructure": false
  },
  "Bootstrap": {
    // 内置超管 admin 的首次登录口令：刻意不在此声明（仓库配置不得含口令）。
    // 非 Development 环境必须经环境变量 / 部署配置显式提供（未提供即启动失败）；
    // Development 未提供时随机生成一次性口令，仅经控制台披露，不写入文件日志。
    // 注意：此处若写成 "AdminInitialPassword": ""，集成测试经 ConfigureAppConfiguration 追加本文件时
    // 会覆盖 ApiTestFactory 注入的测试口令，导致测试宿主启动期基线校验失败。
    // 示例公告、默认部门树等演示数据开关；Production 环境恒定不写入
    "SeedDemoData": true
  },
  "Jwt": {
    "Issuer": "SuperAdmin",
    "Audience": "SuperAdmin",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7,
    "Secret": ""
  },
  "Security": {
    // 口令强度策略：自助改密与管理员重置密码共用；默认值与历史规则一致（6-20 位、含字母与数字）
    "PasswordPolicy": {
      "MinLength": 6,
      "MaxLength": 20,
      "RequireLetter": true,
      "RequireDigit": true,
      "RequireUppercase": false,
      "RequireLowercase": false,
      "RequireSpecialCharacter": false
    },
    // 登录失败锁定阈值：同一用户名连续失败达上限后锁定一段时间（每次失败滑动重置窗口）
    "LoginLock": {
      "MaxFailedAttempts": 5,
      "LockMinutes": 10
    }
  },
  "Export": {
    // 单次导出最大行数（超出截断并在文件名如实标注已导出行数）；防止单次导出耗尽内存
    "MaxRows": 10000
  },
  "MultiTenancy": {
    "Enabled": false
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 100,
    "MaxAttempts": 5,
    // 多副本认领租约（秒）：副本崩溃后到期可被其他副本重新认领
    "LeaseSeconds": 60,
    // 失败退避：第 n 次失败等待 BaseRetryDelaySeconds * 2^(n-1)，上限 MaxRetryDelaySeconds（秒）
    "BaseRetryDelaySeconds": 10,
    "MaxRetryDelaySeconds": 600,
    // 已成功投递消息的保留天数（0 = 不清理）
    "RetentionDays": 7,
    // 死信消息的保留天数（0 = 永久保留供排查 / 重放）
    "FailedRetentionDays": 30,
    // 超过该天数仍未完成投递的 Pending / Processing 消息转死信（0 = 不处理）
    "StalePendingDays": 30
  },
  "Scheduling": {
    // Quartz 工作线程数（并发任务上限）
    "ThreadCount": 10,
    // 启动任务同步锁：等待时间与租约（秒）；滚动发布时仅持锁实例执行差异同步
    "SyncLockWaitSeconds": 10,
    "SyncLockLeaseSeconds": 120,
    // misfire 策略：FireAndProceed（立即补触发）/ RescheduleNextWithRemainingCount（跳过错过触发，按计划重算下一次）
    "MisfireInstruction": "FireAndProceed"
  },
  "Cors": {
    "Enabled": false,
    "AllowedOrigins": [ "http://localhost:5173" ],
    "AllowedHeaders": "Authorization,Content-Type,X-Tenant-Id",
    "AllowedMethods": "GET,POST,PUT,DELETE,OPTIONS",
    "PreflightMaxAgeSeconds": 600
  },
  "RateLimit": {
    "Enabled": true,
    "GlobalPermitLimit": 0,
    "GlobalWindowSeconds": 10,
    "AuthPermitLimit": 100,
    "AuthWindowSeconds": 60
  },
  "Https": {
    "RedirectEnabled": false,
    "HttpsPort": 443,
    "HstsEnabled": false,
    "HstsMaxAgeDays": 180
  },
  "Forwarded": {
    "Enabled": false,
    "Headers": "All",
    "KnownProxies": ""
  },
  "Cache": {
    "RedisEnabled": false,
    "RedisConfiguration": "localhost:6379",
    "InstanceName": "super-admin:",
    "MaximumPayloadBytes": 1048576,
    "Hot": { "LocalSeconds": 30, "DistributedSeconds": 300 },
    "Medium": { "LocalSeconds": 60, "DistributedSeconds": 600 },
    "Cold": { "LocalSeconds": 300, "DistributedSeconds": 1800 }
  },
  "FileStorage": {
    "Provider": "local",
    "RootPath": "uploads",
    "MaxSizeMB": 10,
    "AllowedExtensions": [
      "jpg", "jpeg", "png", "gif", "webp", "bmp",
      "pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "txt", "csv", "md",
      "zip", "rar", "7z"
    ]
  },
  "Mail": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "From": "",
    "Username": "",
    "Password": "",
    "UseSsl": true,
    "Recipients": [],
    "TimeoutMilliseconds": 10000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext:l} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 52428800,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {MachineName} {ThreadId} {SourceContext:l} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*"
}
