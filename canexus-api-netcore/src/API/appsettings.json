{
  "Database": {
    "ConnectionString": "",
    "DbType": "MySql",
    // 库级判定：用剥离库名的管理连接查 information_schema.SCHEMATA；库不存在且允许时自动建库，否则明确拒绝启动
    "AutoCreateDatabase": true,
    // 结构层：已就绪（版本一致 + 模型表齐全）的启动不执行任何 DDL；以下两项仅影响首次初始化
    "AutoCreateTable": true,
    "AutoSyncStructure": true,
    // Production 部署基线要求 AutoCreateTable / AutoSyncStructure 显式为 false；全新生产库须显式授权一次性初始化
    "AllowSchemaInitialization": false,
    // T5 #13：开启后启动期用 EntityMaintenance 模型快照比对 information_schema 列/主键（默认关闭，
    // 存量库完成一次结构对齐后再开启；任何绕过迁移通道改表都会导致启动失败）
    "ValidateModelStructure": false
  },
  "Bootstrap": {
    // 内置超管 admin 的首次登录口令：刻意不在此声明（仓库配置不得含口令）。
    // 非 Development 环境必须经环境变量 / 部署配置显式提供（未提供即启动失败）；
    // Development 未提供时随机生成一次性口令，仅经控制台披露，不写入文件日志。
    // 注意：此处若写成 "AdminInitialPassword": ""，集成测试经 ConfigureAppConfiguration 追加本文件时
    // 会覆盖 ApiTestFactory 注入的测试口令，导致测试宿主启动期基线校验失败。
    // 示例公告、默认部门树等演示数据开关；Production 环境恒定不写入
    "SeedDemoData": true
  },
  "Jwt": {
    // Issuer / Audience / AccessTokenMinutes / RefreshTokenDays 取 JwtOption 代码默认值，此处仅写差异项。
    // Secret 为必填占位：非 Development 环境必须显式注入独立随机密钥（见 ProductionConfigurationValidator），
    // 仓库配置不得含真实密钥。
    "Secret": ""
  },
  "Security": {
    // 口令强度策略（Security:PasswordPolicy）与登录锁定（Security:LoginLock）默认值即安全基线，
    // 已定义在 PasswordPolicyOption（8-20 位、含字母/数字/大写）与 LoginLockOption（5 次 / 10 分钟）中。
    // 仅当部署方需要调整时在此写与默认值不同的项，避免与代码默认值重复漂移（P2-4）；
    // 内置超管初始口令的长度口径亦以 PasswordPolicyOption 基线为准（见 BootstrapOption.Validate）。
  },
  "Export": {
    // 单次导出最大行数取 ExportOption 代码默认值（10000）；超出截断并在文件名如实标注已导出行数，防止单次导出耗尽内存
  },
  "MultiTenancy": {
    "Enabled": false
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 100,
    "MaxAttempts": 5,
    // 多副本认领租约（秒）：副本崩溃后到期可被其他副本重新认领
    "LeaseSeconds": 60,
    // 失败退避：第 n 次失败等待 BaseRetryDelaySeconds * 2^(n-1)，上限 MaxRetryDelaySeconds（秒）
    "BaseRetryDelaySeconds": 10,
    "MaxRetryDelaySeconds": 600,
    // 已成功投递消息的保留天数（0 = 不清理）
    "RetentionDays": 7,
    // 死信消息的保留天数（0 = 永久保留供排查 / 重放）
    "FailedRetentionDays": 30,
    // 超过该天数仍未完成投递的 Pending / Processing 消息转死信（0 = 不处理）
    "StalePendingDays": 30
  },
  "Scheduling": {
    // Quartz 工作线程数（并发任务上限）
    "ThreadCount": 10,
    // 启动任务同步锁：等待时间与租约（秒）；滚动发布时仅持锁实例执行差异同步
    "SyncLockWaitSeconds": 10,
    "SyncLockLeaseSeconds": 120,
    // misfire 策略：FireAndProceed（立即补触发）/ RescheduleNextWithRemainingCount（跳过错过触发，按计划重算下一次）
    "MisfireInstruction": "FireAndProceed"
  },
  "Cors": {
    "Enabled": false,
    "AllowedOrigins": [ "http://localhost:5173" ],
    "AllowedHeaders": "Authorization,Content-Type,X-Tenant-Id",
    "AllowedMethods": "GET,POST,PUT,DELETE,OPTIONS",
    "PreflightMaxAgeSeconds": 600
  },
  "RateLimit": {
    "Enabled": true,
    "GlobalPermitLimit": 0,
    "GlobalWindowSeconds": 10,
    "AuthPermitLimit": 100,
    "AuthWindowSeconds": 60,
    // 分布式限流开关：false = 进程内限流（仅单副本可用）；多副本 / Production 必须为 true。
    // Redis 连接串单一来源：未显式配置 RateLimit:RedisConfiguration 时回退到 Cache:RedisConfiguration，
    // 故此处不再重复声明；确需为限流单独指定 Redis 时再显式覆盖。
    // ProductionConfigurationValidator 会强制校验该开关，docker-compose.yml 已设为 true。
    "UseRedis": false,
    "RedisKeyPrefix": "super-admin:rl:"
  },
  "Https": {
    "RedirectEnabled": false,
    "HttpsPort": 443,
    "HstsEnabled": false,
    "HstsMaxAgeDays": 180
  },
  "Otel": {
    // OpenTelemetry 可观测性：默认关闭；开启后采集 Trace（入站 HTTP / 出站 HttpClient）与运行时指标，
    // 经 OTLP 导出至 Otel:OtlpEndpoint（如 http://otel-collector:4317）；导出失败不影响业务
    "Enabled": false,
    "OtlpEndpoint": ""
  },
  "Forwarded": {
    "Enabled": false,
    "Headers": "All",
    "KnownProxies": ""
  },
  "Cache": {
    // 生产基线要求显式声明 RedisEnabled（ProductionConfigurationValidator 校验）
    "RedisEnabled": false,
    // Redis 连接串单一来源：缓存 L2、失效广播、分布式锁、分布式限流共用；
    // RateLimit 未显式配置 RedisConfiguration 时回退到此值（见 SecurityDependencyExtensions）。
    "RedisConfiguration": "localhost:6379"
    // InstanceName / MaximumPayloadBytes / Hot / Medium / Cold 取 CacheOption 代码默认值，此处仅写差异项
  },
  "FileStorage": {
    "Provider": "local",
    "RootPath": "uploads",
    "MaxSizeMB": 10
    // 上传扩展名白名单取 FileStorageOption 代码默认值；如需收紧 / 放开在此覆写 AllowedExtensions
  },
  "Mail": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "From": "",
    "Username": "",
    "Password": "",
    "UseSsl": true,
    "Recipients": [],
    "TimeoutMilliseconds": 10000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext:l} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 52428800,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {MachineName} {ThreadId} {SourceContext:l} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*"
}
