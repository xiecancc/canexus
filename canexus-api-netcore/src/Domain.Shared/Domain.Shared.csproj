<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- 本地化资源：错误消息 JSON 键值表嵌入主程序集（键约定 Error_{错误码}，zh-CN 为默认资源）；
         文件名用下划线分隔文化（ErrorMessages_zh-CN.json）——点分隔会被 MSBuild 识别为文化后缀
         生成卫星程序集，导致主程序集拿不到资源 -->
    <EmbeddedResource Include="Localization\ErrorMessages_zh-CN.json" />
    <EmbeddedResource Include="Localization\ErrorMessages_en-US.json" />
  </ItemGroup>

</Project>
