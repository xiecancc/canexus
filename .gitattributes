# 默认策略：文本文件 LF 入库，检出时转为当前系统换行符
* text=auto

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf

# 跨平台脚本保留 LF
*.sh    text eol=lf
Dockerfile text eol=lf

# 二进制文件：禁止换行转换与 diff
# 图片
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.ico   binary
*.svgz  binary
*.webp  binary
# 字体
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
# 归档
*.pdf   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.gz    binary
*.jar   binary
# .NET 二进制
*.dll   binary
*.exe   binary
*.pdb   binary
*.snk   binary
*.nupkg binary

# 生成物：不计入语言统计与 diff
pnpm-lock.yaml      linguist-generated=true
package-lock.json   linguist-generated=true
yarn.lock           linguist-generated=true
packages.lock.json  linguist-generated=true

# SDK 生成的工程文件按文本处理
*.csproj    text
*.props     text
*.targets   text
*.slnx      text
